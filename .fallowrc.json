{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": [
    "**/convex/_generated/**",
    "**/dist/**",
    "**/*.tsbuildinfo",
    "artifacts/mockup-sandbox/**",
    "artifacts/research-match/scripts/**"
  ],
  "rules": {
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn"
  },
  "duplicates": {
    "ignore": [
      "**/index.css"
    ]
  }
}
