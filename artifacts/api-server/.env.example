# Set by `pnpm --filter @workspace/api-server exec convex dev`.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Configure these on the Convex deployment with `convex env set`, not only here:
# BETTER_AUTH_SECRET=<a unique secret from openssl rand -base64 32>
# SITE_URL=http://localhost:5173

# Optional Express status API port. Vite proxies /api here by default.
PORT=3001

# Use CONVEX_DEPLOY_KEY only as a local environment variable or CI secret.
# Never expose a deploy key through a VITE_ variable.
